{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowPresignedUploadAndDownload",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME/uploads/*"
    },
    {
      "Sid": "AllowFileMetadataReadWrite",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem",
        "dynamodb:Scan"
      ],
      "Resource": "REPLACE_WITH_DYNAMODB_FILES_TABLE_ARN"
    },
    {
      "Sid": "AllowUserSignupAndLogin",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem"
      ],
      "Resource": "REPLACE_WITH_DYNAMODB_USERS_TABLE_ARN"
    }
  ]
}
